{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information for registered readers, contributors, advertisers, and administrators.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique auth UID of the user." },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name of the user." },
        "role": { "type": "string", "enum": ["admin", "reader", "contributor", "advertiser"], "description": "Access role of the user." },
        "contributorStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"], "description": "Moderation status for contributor role." },
        "contributorBio": { "type": "string", "maxLength": 500, "description": "Contributor journalism bio." },
        "organization": { "type": "string", "maxLength": 150, "description": "Advertiser organization or media house." },
        "passwordHash": { "type": "string", "maxLength": 128, "description": "Hashed credentials for user authentication." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Account update timestamp." }
      },
      "required": ["userId", "email", "displayName", "role"]
    },
    "Article": {
      "title": "Article",
      "description": "News articles authored by approved contributors that publish directly to the portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Article unique ID." },
        "title": { "type": "string", "maxLength": 300, "description": "Article headline." },
        "description": { "type": "string", "maxLength": 500, "description": "Brief summary or lede." },
        "content": { "type": "string", "maxLength": 20000, "description": "Full article story body." },
        "url": { "type": "string", "description": "Reference link." },
        "imageUrl": { "type": "string", "description": "Featured cover image URL." },
        "source": { "type": "string", "maxLength": 100, "description": "Publisher or publication desk." },
        "category": { "type": "string", "maxLength": 50, "description": "Article news category." },
        "author": { "type": "string", "maxLength": 100, "description": "Author full name." },
        "authorId": { "type": "string", "description": "Author user UID." },
        "readingTime": { "type": "number", "description": "Estimated reading duration in minutes." },
        "publishedAt": { "type": "string", "format": "date-time", "description": "Publication timestamp." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["id", "title", "description", "content", "source", "category", "author", "authorId"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved favorite news articles for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Bookmark ID." },
        "userId": { "type": "string", "description": "Owner user UID." },
        "articleId": { "type": "string", "description": "Unique ID of the bookmarked article." },
        "title": { "type": "string", "maxLength": 300, "description": "Article headline." },
        "url": { "type": "string", "description": "Original article link." },
        "imageUrl": { "type": "string", "description": "Featured thumbnail image URL." },
        "source": { "type": "string", "maxLength": 100, "description": "News publisher source." },
        "category": { "type": "string", "maxLength": 50, "description": "Article category." },
        "publishedAt": { "type": "string", "description": "Article publication date." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when bookmarked." }
      },
      "required": ["id", "userId", "articleId", "title", "url", "source", "category"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Interactive discussion comments left by users on news articles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Comment ID." },
        "articleId": { "type": "string", "description": "ID of the article being commented on." },
        "userId": { "type": "string", "description": "Author UID." },
        "userName": { "type": "string", "maxLength": 100, "description": "Author display name." },
        "userEmail": { "type": "string", "format": "email", "description": "Author email address." },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "Comment body text." },
        "likes": { "type": "number", "description": "Number of upvotes." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last edit timestamp." }
      },
      "required": ["id", "articleId", "userId", "userName", "content", "likes"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Portal banner, feed, and billboard advertisements booked by advertisers and approved by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Ad document ID." },
        "title": { "type": "string", "maxLength": 150, "description": "Ad campaign headline." },
        "sponsorName": { "type": "string", "maxLength": 100, "description": "Sponsor or brand name." },
        "imageUrl": { "type": "string", "description": "Creative banner image URL." },
        "targetUrl": { "type": "string", "description": "Destination landing page link." },
        "placement": { "type": "string", "enum": ["top_banner", "sidebar", "in_feed", "breaking_ticker", "article_interstitial", "footer_banner", "popup_billboard"], "description": "Slot placement." },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval status." },
        "durationDays": { "type": "number", "description": "Ad package duration in days." },
        "impressionsTotal": { "type": "number", "description": "Total booked impression quota." },
        "impressionsUsed": { "type": "number", "description": "Impressions served." },
        "remainingQuota": { "type": "number", "description": "Remaining impression balance." },
        "price": { "type": "number", "description": "Total ad order price in Rupiah." },
        "submittedBy": { "type": "string", "description": "User or advertiser UID." },
        "approvedBy": { "type": "string", "description": "Admin UID who reviewed the ad." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Review timestamp." }
      },
      "required": ["id", "title", "sponsorName", "imageUrl", "targetUrl", "placement", "status", "submittedBy"]
    },
    "TrendingNotification": {
      "title": "TrendingNotification",
      "description": "Real-time alerts broadcast for global trending articles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID." },
        "articleId": { "type": "string", "description": "Referenced trending article ID." },
        "title": { "type": "string", "maxLength": 300, "description": "Breaking headline." },
        "summary": { "type": "string", "maxLength": 500, "description": "Short summary." },
        "category": { "type": "string", "maxLength": 50, "description": "News category." },
        "source": { "type": "string", "maxLength": 100, "description": "News source." },
        "trendingScore": { "type": "number", "description": "Popularity score." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Broadcast timestamp." }
      },
      "required": ["id", "articleId", "title", "category", "source"]
    },
    "Admin": {
      "title": "Admin",
      "description": "System admin registration records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Admin UID." },
        "email": { "type": "string", "format": "email", "description": "Admin email address." },
        "role": { "type": "string", "enum": ["admin"], "description": "Admin role designation." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Assignment timestamp." }
      },
      "required": ["userId", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection with role-based attributes."
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Contributor authored news stories published directly."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User saved bookmarks collection."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Article comments collection."
    },
    "/ads/{adId}": {
      "schema": { "$ref": "#/entities/Advertisement" },
      "description": "Advertisements collection requiring admin approval."
    },
    "/trending_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/TrendingNotification" },
      "description": "Real-time world trending news notification alerts."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin records for RBAC validation."
    }
  }
}
